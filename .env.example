# =============================================================================
# PWA Dashboard — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local dev, or set these in the Vercel
# project dashboard (Settings → Environment Variables) for production.

# Base URL of the ESP32 firmware v4.0 REST API.
# - Leave EMPTY in development to use the built-in mock API server (Next.js
#   route handlers under /api/*).
# - Set to your Cloudflare Tunnel URL in production, e.g.:
#     NEXT_PUBLIC_API_BASE_URL=https://timer.your-domain.com
# The PWA will then call ${NEXT_PUBLIC_API_BASE_URL}/api/* instead of the
# relative /api/* mock routes.
NEXT_PUBLIC_API_BASE_URL=

# (Optional) Google Apps Script Web App URL for AI Insights.
# When set, the PWA fetches advisory recommendations from this URL instead
# of showing mock cards. Stub — not yet implemented.
NEXT_PUBLIC_GAS_INSIGHTS_URL=
