# =============================================================================
# PWA Dashboard — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local dev, or set these in the Vercel
# project dashboard (Settings → Environment Variables) for production.

# Base URL of the ESP32 firmware v4.0 REST API (LAN mode).
# - Leave EMPTY for MQTT remote mode (recommended — works from anywhere).
# - Set to ESP32 local IP for LAN-only REST mode (faster, same WiFi required).
# Example: NEXT_PUBLIC_API_BASE_URL=http://192.168.1.50
NEXT_PUBLIC_API_BASE_URL=

# Google Apps Script Web App URL for AI Insights.
# Deploy Code.gs (from download/Code.gs) as a GAS Web App, then paste the
# deployment URL here. PWA fetches AI recommendations from this URL every 5 min.
# Leave EMPTY to use mock insights (no Gemini API calls).
# Example: NEXT_PUBLIC_GAS_INSIGHTS_URL=https://script.google.com/macros/s/AKfyc.../exec
NEXT_PUBLIC_GAS_INSIGHTS_URL=
